{
  "name": "video-ai-hub-desktop",
  "version": "1.0.0",
  "description": "動画生成AIハブ(デスクトップアプリ)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prep": "node scripts/prep.js",
    "start": "npm run prep && electron .",
    "dist": "npm run prep && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.video-ai-hub",
    "productName": "動画生成AIハブ",
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "afterPack": "scripts/adhoc-sign.js",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "ffmpeg-static": "^5.3.0"
  }
}
